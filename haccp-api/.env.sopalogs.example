# Sopalogs RabbitMQ Configuration
# Add these environment variables to your .env file

# === RabbitMQ Broker Connection ===
# Credentials provided by Sopalogs
SOPALOGS_USERNAME=altea
SOPALOGS_PASSWORD=rurs4KxBP4F68y
SOPALOGS_HOST=rabbitmq-lb.bluconsole.com
SOPALOGS_PORT=5671
SOPALOGS_VHOST=/blu-vhost

# === Message Queue Configuration ===
# Exchange and Queue names from Sopalogs
SOPALOGS_MEASUREMENTS_EXCHANGE=/SOPAC/ALTEA CONSEIL/measurements
SOPALOGS_MEASUREMENTS_QUEUE=/SOPAC/ALTEA CONSEIL/measurements
SOPALOGS_HUBS_EXCHANGE=/SOPAC/ALTEA CONSEIL/hubs
SOPALOGS_HUBS_QUEUE=/SOPAC/ALTEA CONSEIL/hubs
SOPALOGS_HUBS_GPS_EXCHANGE=/SOPAC/ALTEA CONSEIL/hubs-gps
SOPALOGS_HUBS_GPS_QUEUE=/SOPAC/ALTEA CONSEIL/hubs-gps

# === Optional: Logging Level ===
# Set to "debug" to see detailed Sopalogs message logs
LOG_LEVEL=info
